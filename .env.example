# Copy this file to .env and fill in the mailbox that sends the enquiry.
# Gmail: host smtp.gmail.com, port 465, and an App Password (not the normal login password).
# Domain mail: use the SMTP host shown in your hosting email panel.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@rebuilttechz.com
SMTP_PASS=
MAIL_TO=info@rebuilttechz.com
PORT=3000
